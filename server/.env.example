# PostgreSQL URLs: use a pooled endpoint for DATABASE_URL and the direct
# endpoint (not the pooler host) for DIRECT_URL migrations.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require"

PORT=4000
CORS_ORIGIN="http://localhost:8081,http://localhost:8082,http://localhost:19006"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Server-only Cloudinary credentials. Never expose the API secret to the mobile app.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
