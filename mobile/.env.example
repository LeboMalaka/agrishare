# For a physical phone, use your computer's LAN address, e.g. http://192.168.1.25:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Web: enable Maps JavaScript API and Geocoding API; restrict by website referrer.
# This public key is bundled into the web app. Never use an unrestricted key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Android native map: enable Maps SDK for Android; restrict by package and signing SHA-1.
# Rebuild the native app after changing this key. iOS uses Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
